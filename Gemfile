source 'https://rubygems.org'

gem 'cocoapods', '1.17.0'
# ActiveSupport (via cocoapods) calls JSON.generate(..., quirks_mode: ...),
# a keyword json 3.x dropped. Pin json to the last 2.x release so pod install
# works on this machine's Ruby 4.0 without touching the Homebrew cocoapods install.
gem 'json', '~> 2.9'
